maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=cosmic-launcher
pkgver=1.7.0
pkgrel=0
source="https://github.com/pop-os/cosmic-launcher/archive/refs/tags/epoch-1.7.0.tar.gz
0002-libcosmic-desktop-feature.patch"

sha256sums=""

build() {
    cd cosmic-launcher-epoch-1.7.0

    patch -p1 < ../0002-libcosmic-desktop-feature.patch

    just xdgen
    cargo build --release --target x86_64-unknown-linux-musl
}

package() {
    just rootdir="$PAYLOAD_DIR" prefix=/overlayer/syshub \
        cargo-target-dir=target/x86_64-unknown-linux-musl install
}
