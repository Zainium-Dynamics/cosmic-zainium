maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=plymouth
pkgver=26.134.222
pkgrel=0
source="https://www.freedesktop.org/software/plymouth/releases/plymouth-$pkgver.tar.xz
0001-overlayer-syshub-font-paths.patch"

makedepends="meson ninja pkgconf libpng-dev eudev-dev pango-dev cairo-dev freetype-dev gtk+3.0-dev libdrm-dev libevdev-dev libxkbcommon-dev xkeyboard-config"
needs_toolchain="systemd systemd-dev xkeyboard-config"

build() {
	export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
	export PATH="/overlayer/syshub/bin:$PATH"
	patch -p1 < ../0001-overlayer-syshub-font-paths.patch
	# our xkeyboard-config syshub pkg ships no .pc (data files only);
	# plymouth only existence-checks this dep, never reads a variable
	sed -i "s#dependency('xkeyboard-config')#dependency('xkeyboard-config', required: false)#" meson.build
	# same story for systemd.pc -- our systemd-dev ships libsystemd.pc
	# but not the top-level systemd.pc metadata package; systemd_dep is
	# only ever used to derive systemdsystemunitdir, so hardcode it
	python3 - <<'EOF'
import re
src = open("meson.build").read()
src = src.replace(
    "systemd_dep = dependency('systemd')\n"
    "  systemd_unit_dir = systemd_dep.get_variable('systemdsystemunitdir',\n"
    "    pkgconfig_define: [ 'rootprefix', get_option('prefix') ],\n"
    "  )",
    "systemd_unit_dir = '/overlayer/syshub/lib/systemd/system'"
)
open("meson.build", "w").write(src)
EOF
	# execinfo.h is glibc-only; musl has no backtrace(), stub the crash
	# handler's debug dump instead of losing the whole build over it
	python3 - <<'PYEOF'
src = open("src/main.c").read()
src = src.replace("#include <execinfo.h>\n", "")
src = src.replace(
    'static void\n'
    'write_backtrace (int output_fd)\n'
    '{\n'
    '        void *addresses[BACKTRACE_SIZE];\n'
    '        int number_of_addresses;\n'
    '\n'
    '        write (output_fd, "backtrace:\\n", strlen ("backtrace:\\n"));\n'
    '        number_of_addresses = backtrace (addresses, BACKTRACE_SIZE);\n'
    '\n'
    '        if (number_of_addresses <= BACKTRACE_FRAMES_TO_SKIP)\n'
    '                return;\n'
    '\n'
    '        backtrace_symbols_fd (addresses + BACKTRACE_FRAMES_TO_SKIP,\n'
    '                              number_of_addresses - BACKTRACE_FRAMES_TO_SKIP,\n'
    '                              output_fd);\n'
    '}',
    'static void\n'
    'write_backtrace (int output_fd)\n'
    '{\n'
    '        write (output_fd, "backtrace: unavailable (musl)\\n", strlen ("backtrace: unavailable (musl)\\n"));\n'
    '}'
)
open("src/main.c", "w").write(src)
PYEOF
	meson setup output --prefix=/overlayer/syshub --sysconfdir=/overlayer/syshub/etc \
		-Dsystemd-integration=true -Ddocs=false
	meson compile -C output
}

package() {
	DESTDIR="$PAYLOAD_DIR" meson install --no-rebuild -C output
}
