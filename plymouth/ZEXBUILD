maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=plymouth
pkgver=26.134.222
pkgrel=0
source="https://www.freedesktop.org/software/plymouth/releases/plymouth-$pkgver.tar.xz
0001-overlayer-syshub-font-paths.patch"

makedepends="meson ninja pkgconf libpng-dev eudev-dev pango-dev cairo-dev freetype-dev gtk+3.0-dev libdrm-dev libevdev-dev libxkbcommon-dev xkeyboard-config"
needs_toolchain="systemd systemd-dev xkeyboard-config"

build() {
	export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
	patch -p1 < ../0001-overlayer-syshub-font-paths.patch
	# our xkeyboard-config syshub pkg ships no .pc (data files only);
	# plymouth only existence-checks this dep, never reads a variable
	sed -i "s#dependency('xkeyboard-config')#dependency('xkeyboard-config', required: false)#" meson.build
	meson setup output --prefix=/overlayer/syshub --sysconfdir=/overlayer/syshub/etc \
		-Dsystemd-integration=true -Ddocs=false
	meson compile -C output
}

package() {
	DESTDIR="$PAYLOAD_DIR" meson install --no-rebuild -C output
}
