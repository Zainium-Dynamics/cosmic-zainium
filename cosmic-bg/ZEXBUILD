maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=cosmic-bg
pkgver=1.7.0
pkgrel=0
source="https://github.com/pop-os/cosmic-bg/archive/refs/tags/epoch-1.7.0.tar.gz
0001-overlayer-syshub-path.patch
0002-data-v1-all-syshub-path.patch"

sha256sums=""  
makedepends="cargo just dav1d-dev wayland-dev libxkbcommon-dev"

build() {

    cd cosmic-bg-epoch-1.7.0

    patch -p1 < ../0001-overlayer-syshub-path.patch
    patch -p1 < ../0002-data-v1-all-syshub-path.patch

    cargo build --release --target x86_64-unknown-linux-musl
}

package() {
    just rootdir="$PAYLOAD_DIR" prefix=/overlayer/syshub \
        cargo-target-dir=target/x86_64-unknown-linux-musl install
}
