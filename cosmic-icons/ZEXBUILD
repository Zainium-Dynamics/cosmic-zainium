maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=cosmic-icons
pkgver=1.6.0
pkgrel=0
# Data-only (icon theme) -- no cargo build, no systemd/path concerns.
# TODO: sha256sums.
source="https://github.com/pop-os/cosmic-icons/archive/refs/tags/epoch-$pkgver.tar.gz"

makedepends="just"

package() {
	# No build() here -- nothing else cd's into the extracted dir for a
	# data-only package, package() has to do it itself.
	cd cosmic-icons-epoch-$pkgver
	just rootdir="$PAYLOAD_DIR" prefix=/overlayer/syshub install
}
