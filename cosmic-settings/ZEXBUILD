maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=cosmic-settings
pkgver=1.7.0
pkgrel=0
source="https://github.com/pop-os/cosmic-settings/archive/refs/tags/epoch-1.7.0.tar.gz
0002-overlayer-syshub-paths.patch
9999-zainium-branding-logos.patch"

sha256sums=""

makedepends="cargo just glib-dev wayland-dev libxkbcommon-dev dav1d-dev"

build() {
    cd cosmic-settings-epoch-1.7.0

    patch -p1 < ../0002-overlayer-syshub-paths.patch
    patch -p1 < ../9999-zainium-branding-logos.patch

    cargo build --release --target x86_64-unknown-linux-musl
}

package() {
    just rootdir="$PAYLOAD_DIR" prefix=/overlayer/syshub \
        cargo-target-dir=target/x86_64-unknown-linux-musl install
}
