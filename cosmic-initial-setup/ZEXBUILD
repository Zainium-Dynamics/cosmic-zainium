maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=cosmic-initial-setup
pkgver=1.6.0
pkgrel=0
# Commit archive at the exact pop-os/cosmic-initial-setup commit pinned by
# ~/cosmic-epoch's epoch-1.5.0 submodule set (verified: git clone --branch
# epoch-1.5.0 resolves to the same commit b5ac4182bb00bc774ca86febadf0369e362bc031
# this recipe was originally pinned at). Patches: systemd removed
# from default features (code changes too, where pristine code doesn't
# compile with systemd off) + any /usr/... path fixed to
# /overlayer/syshub/... . No dbus/flatpak dependency exists in this
# component's own Cargo.toml. Real tagged release, matching Alpine's own
# aports/community APKBUILD for the same package (same epoch-1.5.0 tag,
# same pop-os source).
source="https://github.com/pop-os/cosmic-initial-setup/archive/refs/tags/epoch-1.6.0.tar.gz
0001-overlayer-syshub-paths.patch"

sha256sums=""  # TODO: re-pin for epoch-1.6.0 (was pinned for 1.5.0)

build() {
    # GitHub tag-archive extracted-dir name is $pkgname-epoch-$pkgver, not $pkgname-$pkgver.
    cd cosmic-initial-setup-epoch-1.6.0

    patch -p1 < ../0001-overlayer-syshub-paths.patch

    cargo build --release --target x86_64-unknown-linux-musl
}

package() {
    just rootdir="$PAYLOAD_DIR" prefix=/overlayer/syshub \
        cargo-target-dir=target/x86_64-unknown-linux-musl install
}
