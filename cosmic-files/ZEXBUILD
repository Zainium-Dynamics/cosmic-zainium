maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=cosmic-files
pkgver=1.6.0
pkgrel=0
# No systemd/logind Cargo feature -- file manager, no session/bus
# integration of its own. TODO: sha256sums.
source="https://github.com/pop-os/cosmic-files/archive/refs/tags/epoch-$pkgver.tar.gz"

makedepends="cargo clang-libclang glib-dev just libxkbcommon-dev wayland-dev"

build() {
	cd cosmic-files-epoch-$pkgver
	export VERGEN_GIT_COMMIT_DATE="$(date -u '+%Y-%m-%d')"
	export VERGEN_GIT_SHA="unknown"
	cargo build --release --target x86_64-unknown-linux-musl
	cargo build --release --target x86_64-unknown-linux-musl --package cosmic-files-applet
}

package() {
	cd cosmic-files-epoch-$pkgver
	just rootdir="$PAYLOAD_DIR" prefix=/overlayer/syshub \
		cargo-target-dir=target/x86_64-unknown-linux-musl install
}
