maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=cosmic-panel
pkgver=1.8.0
pkgrel=0
source="https://github.com/pop-os/cosmic-panel/archive/refs/tags/epoch-$pkgver.tar.gz"

makedepends="appstream-glib cargo desktop-file-utils findutils intltool just libxkbcommon-dev wayland-dev wayland-protocols"

build() {
	cd cosmic-panel-epoch-$pkgver
	cargo build --release --target x86_64-unknown-linux-musl
}

package() {
	just rootdir="$PAYLOAD_DIR" prefix=/overlayer/syshub \
		cargo-target-dir=target/x86_64-unknown-linux-musl install
}
