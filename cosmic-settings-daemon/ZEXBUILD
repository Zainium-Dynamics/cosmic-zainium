maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=cosmic-settings-daemon
pkgver=1.8.0
pkgrel=0

source="https://github.com/pop-os/cosmic-settings-daemon/archive/refs/tags/epoch-1.8.0.tar.gz
0001-overlayer-syshub-paths.patch"
makedepends="cargo clang-libclang libinput-dev libxkbcommon-dev openssl-dev pipewire-dev pulseaudio-dev"

build() {
    cd cosmic-settings-daemon-epoch-1.7.0

    patch -p1 < ../0001-overlayer-syshub-paths.patch

    
    export LIBCLANG_PATH="$(dirname "$(find /usr/lib -name 'libclang.so*' | head -1)")"
    mkdir -p .cargo
    cat > .cargo/config.toml <<-'EOF'
	[host]
	rustflags = ["-C", "target-feature=-crt-static"]
	EOF
    cargo build -Z host-config -Z target-applies-to-host --release
}

package() {
    make DESTDIR="$PAYLOAD_DIR" prefix=/overlayer/syshub \
        geoclue_agent=/overlayer/syshub/libexec/geoclue-2.0/demos/agent install
}
