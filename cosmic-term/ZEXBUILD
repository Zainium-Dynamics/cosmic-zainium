maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=cosmic-term
pkgver=1.10.0
pkgrel=1
source="https://github.com/pop-os/cosmic-term/archive/refs/tags/epoch-1.10.0.tar.gz
0001-oxidized-env-resolver.patch
0002-kitty-graphics.patch"

sha256sums=""

makedepends="cargo just libxkbcommon-dev wayland-dev"

build() {
    # GitHub tag-archive extracted-dir name is $pkgname-epoch-$pkgver, not $pkgname-$pkgver.
    cd cosmic-term-epoch-1.10.0

    patch -p1 < ../0001-oxidized-env-resolver.patch
    # images in the terminal (kitty graphics protocol): screenfetch, chafa, icat, yazi previews
    patch -p1 < ../0002-kitty-graphics.patch

    cargo build --release --target x86_64-unknown-linux-musl
}

package() {
    just rootdir="$PAYLOAD_DIR" prefix=/overlayer/syshub \
        cargo-target-dir=target/x86_64-unknown-linux-musl install
}
