maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=cosmic-session
pkgver=1.7.0
pkgrel=0
source="https://github.com/pop-os/cosmic-session/archive/refs/tags/epoch-1.7.0.tar.gz
0003-overlayer-syshub-path.patch
0004-desktop-file-path.patch
0005-start-cosmic-no-usr-path.patch
0006-qt-plugin-path-syshub.patch"

sha256sums=""

build() {
    cd cosmic-session-epoch-1.7.0

    patch -p1 < ../0003-overlayer-syshub-path.patch
    patch -p1 < ../0004-desktop-file-path.patch
    patch -p1 < ../0005-start-cosmic-no-usr-path.patch
    patch -p1 < ../0006-qt-plugin-path-syshub.patch

    cargo build --release --target x86_64-unknown-linux-musl
}

package() {
    just rootdir="$PAYLOAD_DIR" prefix=/overlayer/syshub \
        cargo-target-dir=target/x86_64-unknown-linux-musl install
    rm -rf "$PAYLOAD_DIR"/overlayer/syshub/lib/systemd
}
